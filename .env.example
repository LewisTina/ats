# Provider configuration: "openai" | "openrouter" | "gemini" | "ollama" | "groq" | "custom"
AI_PROVIDER=openai

# API Key (kept strictly on server side)
AI_API_KEY=

# Base URL (optional, overrides default endpoint)
# AI_BASE_URL=https://api.openai.com/v1
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_BASE_URL=http://localhost:11434/v1

# Model identifier
AI_MODEL=gpt-4o-mini
